              "subnet": {
                "id": "/subscriptions/fb5e8372-fcd5-4ab5-ac1a-b155e805eb42/resourceGroups/rg-novatrix-v36-bastion/providers/Microsoft.Network/virtualNetworks/vnet-novatrix/subnets/AzureBastionSubnet"
