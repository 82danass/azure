      "tags": "[parameters('tags')]",
      "properties": {
        "publicIPAllocationMethod": "Static"
      },
      "sku": {
        "name": "Standard"
      }
    },
    {
      "type": "Microsoft.Network/bastionHosts",
      "apiVersion": "2024-05-01",
      "name": "bastion-novatrix-v36-bastion",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "enableTunneling": true,
        "ipConfigurations": [
          {
            "name": "bastion",
