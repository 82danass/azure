    },
    "bastionipName": {
      "type": "string",
      "value": "bastionip-novatrix-v36-bastion"
    },
    "bastionipType": {
      "type": "string",
      "value": "Microsoft.Network/publicIPAddresses"
    },
    "bastionId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/bastionHosts', 'bastion-novatrix-v36-bastion')]"
    },
    "bastionName": {
      "type": "string",
      "value": "bastion-novatrix-v36-bastion"
    },
    "bastionType": {
      "type": "string",
      "value": "Microsoft.Network/bastionHosts"
    }
  }
