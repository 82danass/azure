  "rbac": {
    "assignments": [
      {
        "role": "Storage Blob Data Contributor",
        "principal": {
          "kind": "managedIdentity",
          "purpose": "portal"
        },
        "scope": {
          "container": "bilder"
        },
        "justification": "The portal saves each report's image. On container bilder only: contracts in dokument are out of its reach."
      },
      {
        "role": "Storage Table Data Contributor",
        "principal": {
          "kind": "managedIdentity",
          "purpose": "portal"
        },
        "scope": {
          "table": "anmalningar"
        },
        "justification": "The portal writes each report's record and reads a tenant's own, or a manager's board."
      },
      {
        "role": "Storage Table Data Contributor",
        "principal": {
          "kind": "managedIdentity",
          "purpose": "portal"
        },
        "scope": {
          "table": "fastigheter"
        },
        "justification": "Managers add properties and take responsibility for them on the board; the form lists them."
      },
      {
        "role": "Storage Queue Data Message Sender",
        "principal": {
          "kind": "managedIdentity",
          "purpose": "portal"
        },
        "scope": {
          "queue": "nya-anmalningar"
        },
        "justification": "The portal hands each report to the Function and never waits for it. It may send, not read."
      },
      {
        "role": "Communication and Email Service Owner",
        "principal": {
          "kind": "managedIdentity",
          "purpose": "portal"
        },
        "scope": {
          "purpose": "acs"
        },
        "justification": "The portal sends a tenant's one-time code and the personal link to their reports. On the Communication Services resource alone; no key exists to leak."
      },
      {
        "role": "Storage Queue Data Reader",
        "principal": {
          "kind": "managedIdentity",
          "purpose": "notify"
        },
        "scope": {
          "queue": "nya-anmalningar"
        },
        "justification": "The queue trigger reads the queue's length and its messages."
      },
      {
        "role": "Storage Queue Data Message Processor",
        "principal": {
          "kind": "managedIdentity",
          "purpose": "notify"
        },
        "scope": {
          "queue": "nya-anmalningar"
        },
        "justification": "The trigger takes a message and deletes it once the report is handled."
      },
      {
        "role": "Storage Table Data Contributor",
        "principal": {
          "kind": "managedIdentity",
          "purpose": "notify"
        },
        "scope": {
          "table": "anmalningar"
        },
        "justification": "The Function reads the report and records its incident and its item in the list."
      },
      {
        "role": "Storage Table Data Reader",
        "principal": {
          "kind": "managedIdentity",
          "purpose": "notify"
        },
        "scope": {
          "table": "fastigheter"
        },
        "justification": "The Function looks up who holds a report's property. A property nobody holds goes to Otilldelade. It reads; it writes nothing."
      },
      {
        "role": "Storage Blob Data Owner",
        "principal": {
          "kind": "managedIdentity",
          "purpose": "notify"
        },
        "scope": {
          "purpose": "fnstorage"
        },
        "justification": "The Function host keeps its package and bookkeeping here, as Microsoft's template grants it. Its own account, so the role reaches no tenant data."
      },
      {
        "role": "Communication and Email Service Owner",
        "principal": {
          "kind": "managedIdentity",
          "purpose": "notify"
        },
        "scope": {
          "purpose": "acs"
        },
        "justification": "The Function sends the mail and reads the managed domain's sender address. On the Communication Services resource alone; no key exists to leak."
      },
      {
        "role": "Reader",
        "principal": {
          "kind": "managedIdentity",
          "purpose": "ekonomi"
        },
        "scope": "resourceGroup",
        "justification": "The finance site lists the group's resources and their tags. Reader sees names and settings, no data, and no key exists to read."
