{
  "$schema": "https://raw.githubusercontent.com/Arelius-D/mov/main/src/mov/data/schema/profile.schema.json",
  "env": "nordvik-v41-prod",
  "description": "Nordvik Fastigheter AB's tenant portal, production. Tenants report faults with an image at mov25-nordvik.assarelius.org without an account: a one-time code to their own email confirms it, and a personal link lets them follow their reports. Managers judge and handle them on a board in the same portal; finance reads reports and what hosting costs at mov25-ekonomi.assarelius.org. Both sites are Container Apps in a zone-redundant environment: the portal keeps 2 replicas on weekdays 06-21 and scales to 6 on traffic and to 0 at night. A report is saved to private storage and queued; a Flex Consumption Function works the queue, groups reports into incidents, writes each to the list in Nordvik's Microsoft 365 through Graph, and mails through Communication Services only where someone must act. Nothing holds a secret that reaches Azure or Microsoft 365: staff sign in through registrations that trust the sites' identities, and the Function and the finance site borrow, while this environment stands, the rights of two apps made once by v41/setup. All storage is reached through private endpoints only. Pinned to rg-nordvik, the brief's own example. Switch to this workspace with `mov workspace use mov25-nordvik`. NORDVIK_M365_APP_ID and NORDVIK_COST_APP_ID are the app ids of app-nordvik-m365 and app-nordvik-kostnad, written in once by v41/setup/setup.ps1 after it has made the two apps.",
  "resourceGroup": "rg-nordvik",
  "stages": [
    "preflight",
    "rg",
    "network",
    "cost",
    "directory",
    "identity",
    "applications",
    "cloudflare",
    "storage",
    "resources",
    "rbac",
    "apps",
    "verify"
  ],
  "network": {
    "addressSpace": "10.41.0.0/16",
    "subnets": [
      {
        "purpose": "apps",
        "prefix": "10.41.0.0/27",
        "kind": "containerApps",
        "private": true
      },
      {
        "purpose": "func",
        "prefix": "10.41.0.32/27",
        "kind": "containerApps",
        "private": false
      },
      {
        "purpose": "data",
        "prefix": "10.41.1.0/27",
        "nsg": "data",
        "private": true
      }
    ],
    "nsg": {
      "data": [
        {
          "name": "storage-from-apps",
          "priority": 100,
          "ports": [
            "443"
          ],
          "source": "10.41.0.0/27",
          "description": "The portal and the finance site reach Nordvik's storage through its private endpoints."
        },
        {
          "name": "storage-from-func",
          "priority": 110,
          "ports": [
            "443"
          ],
          "source": "10.41.0.32/27",
          "description": "The Function reaches the queue, the table and its own storage through their private endpoints."
        },
        {
          "name": "deny-all-inbound",
          "priority": 4000,
          "access": "Deny",
          "protocol": "*",
          "ports": [
            "*"
          ]
        }
      ]
    }
  },
  "identity": {
    "userAssigned": [
      {
        "purpose": "portal",
        "description": "The portal's identity: writes report images to container bilder, records to table anmalningar and a message to queue nya-anmalningar, each on that one container, table or queue. Its sign-in registration trusts it, so the portal holds no client secret. It also sends tenants their one-time codes and personal links through Communication Services."
      },
      {
        "purpose": "notify",
        "description": "The Function's identity: works the queue, records each report's incident, mails through Communication Services, and runs the Function host on its own account. It borrows app-nordvik-m365's right to write the one list in Nordvik's Microsoft 365. The trust is added by v41/setup/trust.ps1 after `mov up` and removed by it before `mov down`."
      },
      {
        "purpose": "ekonomi",
        "description": "The finance site's identity: reads the group's resources and counts reports. It borrows app-nordvik-kostnad's right to read cost, budgets and the billing profile. Its sign-in registration trusts it. The trust is added by v41/setup/trust.ps1 after `mov up` and removed by it before `mov down`."
      }
    ],
    "applications": [
      {
        "purpose": "portal",
        "description": "Staff sign-in to the portal: managers and finance; the groups claim decides the role. Tenants need no account. Holds no secret: it trusts the portal's identity.",
        "redirectUris": [
          "https://mov25-nordvik.assarelius.org/auth/callback"
        ],
        "claims": {
          "email": true,
          "groups": true
        },
        "trusts": [
          "portal"
        ]
      },
      {
        "purpose": "ekonomi",
        "description": "Sign-in to the finance site; the site lets in grp-nordvik-ekonomi only. Holds no secret: it trusts the finance site's identity.",
        "redirectUris": [
          "https://mov25-ekonomi.assarelius.org/auth/callback"
        ],
        "claims": {
          "email": true,
          "groups": true
        },
        "trusts": [
          "ekonomi"
        ]
      }
    ]
  },
