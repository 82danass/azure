[Unit]
Description=Startar det som behöver hemligheterna mov levererat
After=network-online.target

[Service]
Type=oneshot
# Skrivs av bootstrap: vilket skript som ska köras när filen finns.
EnvironmentFile=/etc/mov/deploy.env
ExecStart=/opt/novatrix/on-secrets.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
