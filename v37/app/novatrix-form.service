[Unit]
Description=Novatrix ärendeformulär
After=network-online.target
Wants=network-online.target

[Service]
User=www-data
Group=www-data
EnvironmentFile=/etc/mov/deploy.env
WorkingDirectory=/opt/novatrix-form
ExecStart=/usr/bin/gunicorn --bind 127.0.0.1:8080 --workers 2 --timeout 60 form:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
