{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "swedencentral"
    },
    "tags": {
      "value": {
        "course": "MOV25",
        "company": "Novatrix AB",
        "env": "v38",
        "managedBy": "mov"
      }
    },
    "vnetName": {
      "value": "vnet-novatrix"
    },
    "addressSpace": {
      "value": "10.38.0.0/16"
    },
    "networkSecurityGroups": {
      "value": [
        {
          "name": "nsg-novatrix-web",
          "rules": [
            {
              "name": "http",
              "properties": {
                "description": "",
                "priority": 100,
                "direction": "Inbound",
                "access": "Allow",
                "protocol": "Tcp",
                "sourceAddressPrefix": "*",
                "destinationAddressPrefix": "*",
                "sourcePortRange": "*",
                "destinationPortRange": "80"
              }
            },
            {
              "name": "ssh",
              "properties": {
                "description": "",
                "priority": 120,
                "direction": "Inbound",
                "access": "Allow",
                "protocol": "Tcp",
                "sourceAddressPrefix": "185.195.233.177/32",
                "destinationAddressPrefix": "*",
                "sourcePortRange": "*",
                "destinationPortRange": "22"
              }
            },
            {
              "name": "deny-all-inbound",
              "properties": {
                "description": "",
                "priority": 4000,
                "direction": "Inbound",
                "access": "Deny",
                "protocol": "*",
                "sourceAddressPrefix": "*",
                "destinationAddressPrefix": "*",
                "sourcePortRange": "*",
                "destinationPortRange": "*"
              }
            }
          ]
        },
        {
          "name": "nsg-novatrix-data",
          "rules": [
            {
              "name": "allow-web-subnet",
              "properties": {
                "description": "",
                "priority": 100,
                "direction": "Inbound",
                "access": "Allow",
                "protocol": "*",
                "sourceAddressPrefix": "10.38.1.0/24",
                "destinationAddressPrefix": "*",
                "sourcePortRange": "*",
                "destinationPortRange": "*"
              }
            },
            {
              "name": "deny-internet-inbound",
              "properties": {
                "description": "",
                "priority": 4000,
                "direction": "Inbound",
                "access": "Deny",
                "protocol": "*",
                "sourceAddressPrefix": "Internet",
                "destinationAddressPrefix": "*",
                "sourcePortRange": "*",
                "destinationPortRange": "*"
              }
            }
          ]
        }
      ]
    },
    "subnets": {
      "value": [
        {
          "purpose": "web",
          "name": "snet-novatrix-web",
          "prefix": "10.38.1.0/24",
          "nsgName": "nsg-novatrix-web",
          "serviceEndpoints": [
            {
              "service": "Microsoft.Storage"
            }
          ]
        },
        {
          "purpose": "data",
          "name": "snet-novatrix-data",
          "prefix": "10.38.2.0/24",
          "nsgName": "nsg-novatrix-data",
          "serviceEndpoints": []
        }
      ]
    }
  }
}
