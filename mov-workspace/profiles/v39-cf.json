{
  "$schema": "https://raw.githubusercontent.com/Arelius-D/mov/main/src/mov/data/schema/profile.schema.json",
  "env": "v39-cf",
  "description": "Automation and integration, as code. The public form (web) writes each ticket as a row in a ticket registry (NocoDB on ops). Staff reach the registry at mov25-tickets.assarelius.org through a Cloudflare tunnel, behind a Cloudflare Access sign-in with Entra ID as the identity provider; the ops machine has no open port. A webhook on every new row sends mail through Azure Communication Services and a notice to Teams. The Entra app registration, the tunnel, the records, the mail service and every secret are part of the profile. Run `mov up v39-cf`.",
  "stages": [
    "preflight",
    "rg",
    "network",
    "cost",
    "directory",
    "identity",
    "applications",
    "cloudflare",
    "resources",
    "rbac",
    "compute",
    "verify"
  ],
  "network": {
    "addressSpace": "10.39.0.0/16",
    "subnets": [
      {
        "purpose": "web",
        "prefix": "10.39.1.0/24",
        "nsg": "web"
      },
      {
        "purpose": "ops",
        "prefix": "10.39.2.0/24",
        "nsg": "ops"
      }
    ],
    "nsg": {
      "web": [
        {
          "name": "http",
          "priority": 100,
          "ports": [
            "80"
          ],
          "description": "The ticket form is public by design, and Let's Encrypt proves the hostname over it."
        },
        {
          "name": "https",
          "priority": 110,
          "ports": [
            "443"
          ],
          "description": "The form over TLS: the machine's own certificate, which Cloudflare's edge connects to."
        },
        {
          "name": "ssh",
          "priority": 120,
          "ports": [
            "22"
          ],
          "source": "${admin.sshSource}",
          "description": "Administrative access from where mov is run."
        },
        {
          "name": "deny-all-inbound",
          "priority": 4000,
          "access": "Deny",
          "protocol": "*",
          "ports": [
            "*"
          ]
        }
      ],
      "ops": [
        {
          "name": "registry-from-web",
          "priority": 100,
          "ports": [
            "8080"
          ],
          "source": "10.39.1.0/24",
          "description": "The form writes tickets over the private network. Staff come in through the tunnel, which opens no port here."
        },
        {
          "name": "ssh",
          "priority": 110,
          "ports": [
            "22"
          ],
          "source": "${admin.sshSource}",
          "description": "Administrative access, and the channel the secrets arrive on."
        },
        {
          "name": "deny-all-inbound",
          "priority": 4000,
          "access": "Deny",
          "protocol": "*",
          "ports": [
            "*"
          ]
        }
      ]
    }
  },
  "identity": {
    "userAssigned": [
      {
        "purpose": "notify",
        "description": "The notifier's identity: sends mail through Communication Services, reads the mail domain's sender address."
      }
    ],
    "applications": [
      {
        "purpose": "signin",
        "description": "The sign-in in front of the ticket registry: Cloudflare Access signs staff in with Entra ID through this registration.",
        "claims": {
          "email": true,
          "groups": true
        },
        "secret": "OAUTH_CLIENT_SECRET"
      }
    ]
  },
  "cloudflare": {
    "records": [
      {
        "name": "form",
        "host": "web"
      }
    ],
    "tunnel": {
      "host": "ops",
      "secret": "TUNNEL_TOKEN",
      "routes": [
        {
          "name": "tickets",
          "service": "http://127.0.0.1:8080"
        }
      ]
    },
    "access": [
      {
        "name": "tickets",
        "idp": "signin",
        "allow": {
          "everyone": true
        }
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.Communication/emailServices",
      "apiVersion": "2023-04-01",
      "purpose": "mail",
      "location": "global",
      "properties": {
        "dataLocation": "Europe"
      }
    },
    {
      "type": "Microsoft.Communication/emailServices/domains",
      "apiVersion": "2023-04-01",
      "purpose": "maildomain",
      "name": "mail-novatrix-v39-cf/AzureManagedDomain",
      "location": "global",
      "dependsOn": [
        "mail"
      ],
      "properties": {
        "domainManagement": "AzureManaged",
        "userEngagementTracking": "Disabled"
      }
    },
    {
      "type": "Microsoft.Communication/communicationServices",
      "apiVersion": "2023-04-01",
      "purpose": "acs",
      "location": "global",
      "properties": {
        "dataLocation": "Europe",
        "linkedDomains": [
          "@resourceId:maildomain"
        ]
      }
    }
  ],
  "rbac": {
    "assignments": [
      {
        "role": "Virtual Machine Contributor",
        "principal": {
          "kind": "group",
          "purpose": "drift"
        },
        "scope": "resourceGroup",
        "justification": "Operations start, stop and rebuild the machines, and change neither network nor roles."
      },
      {
        "role": "Reader",
        "principal": {
          "kind": "group",
          "purpose": "support"
        },
        "scope": "resourceGroup",
        "justification": "Support works in the ticket registry, not in Azure; read is for seeing that the environment stands."
      },
      {
        "role": "Reader",
        "principal": {
          "kind": "group",
          "purpose": "granskning"
        },
        "scope": "resourceGroup",
        "justification": "A review reads and changes nothing."
      },
      {
        "role": "Communication and Email Service Owner",
        "principal": {
          "kind": "managedIdentity",
          "purpose": "notify"
        },
        "scope": "resourceGroup",
        "justification": "The notifier sends mail with the machine's identity and reads the managed domain's sender address. The role is the Communication services' own, on the group that holds only this environment's; no key exists to leak."
      }
    ]
  },
  "compute": {
    "vms": [
      {
        "purpose": "ops",
        "subnet": "ops",
        "size": "Standard_B2ls_v2",
        "identities": [
          "notify"
        ],
        "source": {
          "path": "v39",
          "bootstrap": "scripts/bootstrap-v39-ops.sh"
        },
        "host": {
          "packages": [
            "git",
            "docker.io",
            "python3-venv",
            "jq",
            "curl"
          ],
          "updatePackages": true,
          "upgradePackages": true,
          "rebootIfRequired": true
        },
        "environment": {
          "NOVATRIX_TICKET_HOST": "@output:cloudflare.hosts.tickets",
          "AZURE_CLIENT_ID": "@output:identity.identities.notify.clientId",
          "NOVATRIX_ACS_ID": "@output:resources.acsId",
          "NOVATRIX_MAIL_DOMAIN_ID": "@output:resources.maildomainId",
          "NOVATRIX_SUPPORT_EMAIL": "assarelius@icloud.com",
          "NC_ADMIN_EMAIL": "admin@novatrix.se"
        },
        "secrets": [
          "TUNNEL_TOKEN",
          "NC_AUTH_JWT_SECRET",
          "NC_ADMIN_PASSWORD",
          "TEAMS_WEBHOOK_URL"
        ],
        "verify": {
          "http": false,
          "host": [
            {
              "name": "cloud-init",
              "run": "cloud-init status | head -n 1",
              "expect": "status: done"
            },
            {
              "name": "secrets landed",
              "run": "systemctl is-active novatrix-notify",
              "expect": "active"
            },
            {
              "name": "registry",
              "run": "sudo docker inspect -f '{{.State.Status}}' noco",
              "expect": "running"
            },
            {
              "name": "tunnel",
              "run": "systemctl is-active cloudflared",
              "expect": "active"
            },
            {
              "name": "door closed to anonymous",
              "run": "bash -c '. /etc/mov/deploy.env; curl -s -o /dev/null -w %{http_code} https://$NOVATRIX_TICKET_HOST/'",
              "expect": "302"
            },
            {
              "name": "notifier reaches mail",
              "run": "curl -sf http://127.0.0.1:9000/health | grep -o '\"status\":\"ok\"'",
              "expect": "\"status\":\"ok\""
            },
            {
              "name": "pending upgrades",
              "run": "apt-get -s upgrade | grep -c '^Inst' || true",
              "expect": "0",
              "optional": true
            }
          ]
        }
      },
      {
        "purpose": "web",
        "subnet": "web",
        "source": {
          "path": "v39",
          "bootstrap": "scripts/bootstrap-v39-web.sh"
        },
        "host": {
          "packages": [
            "git",
            "nginx",
            "python3-flask",
            "gunicorn",
            "certbot"
          ],
          "updatePackages": true,
          "upgradePackages": true,
          "rebootIfRequired": true
        },
        "environment": {
          "NOVATRIX_TICKETS_URL": "http://vm-novatrix-ops:8080",
          "NOVATRIX_FORM_HOST": "@output:cloudflare.hosts.form",
          "NC_ADMIN_EMAIL": "admin@novatrix.se"
        },
        "secrets": [
          "NC_ADMIN_PASSWORD"
        ],
        "verify": {
          "host": [
            {
              "name": "cloud-init",
              "run": "cloud-init status | head -n 1",
              "expect": "status: done"
            },
            {
              "name": "form service",
              "run": "systemctl is-active novatrix-form",
              "expect": "active"
            },
            {
              "name": "form reaches registry",
              "run": "curl -sf http://127.0.0.1:8080/health | grep -o '\"status\":\"ok\"'",
              "expect": "\"status\":\"ok\""
            },
            {
              "name": "certificate",
              "run": "bash -c '. /etc/mov/deploy.env; curl -s -o /dev/null -w %{http_code} https://$NOVATRIX_FORM_HOST/'",
              "expect": "200"
            },
            {
              "name": "a ticket and its attachment land",
              "run": "printf verify > /tmp/verify-bilaga.txt; curl -sf -F name=verify -F email=verify@novatrix.se -F message=verifiering -F attachment=@/tmp/verify-bilaga.txt 'http://127.0.0.1/arenden?format=json' > /tmp/verify-arende.json && grep -q '\"name\":\"verify-bilaga.txt\"' /tmp/verify-arende.json && grep -o '\"status\":\"stored\"' /tmp/verify-arende.json",
              "expect": "\"status\":\"stored\""
            },
            {
              "name": "pending upgrades",
              "run": "apt-get -s upgrade | grep -c '^Inst' || true",
              "expect": "0",
              "optional": true
            }
          ]
        }
      }
    ]
  }
}
