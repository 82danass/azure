{
  "$schema": "https://raw.githubusercontent.com/Arelius-D/mov/main/src/mov/data/schema/profile.schema.json",
  "env": "v36-jumphost",
  "extends": "v36",
  "description": "v36 with administrative access through a hop. The form VM takes ssh only from the management subnet; the hop takes it only from admin.sshSource and serves nothing. `mov ssh v36-jumphost web` goes through the hop. Run `mov up v36-jumphost --set admin.sshSource=<your-ip>/32`.",
  "network": {
    "addressSpace": "10.36.0.0/16",
    "subnets": [
      {
        "purpose": "web",
        "prefix": "10.36.1.0/24",
        "nsg": "web"
      },
      {
        "purpose": "data",
        "prefix": "10.36.2.0/24",
        "nsg": "data",
        "private": true
      },
      {
        "purpose": "mgmt",
        "prefix": "10.36.3.0/24",
        "nsg": "mgmt"
      }
    ],
    "nsg": {
      "web": [
        {
          "name": "http",
          "priority": 100,
          "ports": [
            "80"
          ],
          "description": "The errand form is public by design."
        },
        {
          "name": "https",
          "priority": 110,
          "ports": [
            "443"
          ],
          "description": "Reserved for TLS."
        },
        {
          "name": "ssh",
          "priority": 120,
          "ports": [
            "22"
          ],
          "source": "10.36.3.0/24",
          "description": "Administrative access from the management subnet only. Nothing on the internet can open 22 here."
        },
        {
          "name": "deny-all-inbound",
          "priority": 4000,
          "access": "Deny",
          "protocol": "*",
          "ports": [
            "*"
          ],
          "description": "Everything not allowed above is refused explicitly."
        }
      ],
      "data": [
        {
          "name": "allow-web-subnet",
          "priority": 100,
          "protocol": "*",
          "ports": [
            "*"
          ],
          "source": "10.36.1.0/24",
          "description": "Only the web tier may reach the data tier."
        },
        {
          "name": "deny-internet-inbound",
          "priority": 4000,
          "access": "Deny",
          "protocol": "*",
          "ports": [
            "*"
          ],
          "source": "Internet",
          "description": "The data subnet is never reachable from the internet."
        }
      ],
      "mgmt": [
        {
          "name": "ssh",
          "priority": 100,
          "ports": [
            "22"
          ],
          "source": "${admin.sshSource}",
          "description": "The one door in, from one address."
        },
        {
          "name": "deny-all-inbound",
          "priority": 4000,
          "access": "Deny",
          "protocol": "*",
          "ports": [
            "*"
          ],
          "description": "The hop does nothing else."
        }
      ]
    }
  },
  "compute": {
    "vms": [
      {
        "purpose": "web",
        "subnet": "web",
        "via": "jump",
        "source": {
          "path": "v36/public"
        }
      },
      {
        "purpose": "jump",
        "subnet": "mgmt",
        "app": false,
        "host": {
          "packages": [
            "openssh-client"
          ],
          "updatePackages": true,
          "upgradePackages": true,
          "rebootIfRequired": false
        },
        "verify": {
          "host": [
            {
              "name": "cloud-init",
              "run": "cloud-init status --wait",
              "expect": "status: done"
            },
            {
              "name": "nothing served",
              "run": "systemctl is-active nginx || true",
              "expect": "inactive"
            }
          ]
        }
      }
    ]
  }
}
