{
  "$schema": "https://raw.githubusercontent.com/Arelius-D/mov/main/src/mov/data/schema/profile.schema.json",
  "env": "v38",
  "extends": "v37",
  "description": "Infrastructure as code. The v37 environment, deployed from the profile and recorded as the ARM templates and parameters Azure received, so the week's history is the templates' history. Run `mov up v38`, then `mov templates export v38`; admin.sshSource is `@caller`, so the ssh rule follows wherever mov is run from.",
  "network": {
    "addressSpace": "10.38.0.0/16",
    "subnets": [
      {
        "purpose": "web",
        "prefix": "10.38.1.0/24",
        "nsg": "web",
        "serviceEndpoints": [
          "Microsoft.Storage"
        ]
      },
      {
        "purpose": "data",
        "prefix": "10.38.2.0/24",
        "nsg": "data",
        "private": true
      }
    ],
    "nsg": {
      "web": [
        {
          "name": "http",
          "priority": 100,
          "ports": [
            "80"
          ]
        },
        {
          "name": "ssh",
          "priority": 120,
          "ports": [
            "22"
          ],
          "source": "${admin.sshSource}"
        },
        {
          "name": "deny-all-inbound",
          "priority": 4000,
          "access": "Deny",
          "protocol": "*",
          "ports": [
            "*"
          ]
        }
      ],
      "data": [
        {
          "name": "allow-web-subnet",
          "priority": 100,
          "protocol": "*",
          "ports": [
            "*"
          ],
          "source": "10.38.1.0/24"
        },
        {
          "name": "deny-internet-inbound",
          "priority": 4000,
          "access": "Deny",
          "protocol": "*",
          "ports": [
            "*"
          ],
          "source": "Internet"
        }
      ]
    }
  },
  "storage": {
    "seq": 2
  },
  "compute": {
    "vms": [
      {
        "purpose": "web",
        "subnet": "web",
        "size": "Standard_D2als_v6",
        "identities": [
          "app"
        ],
        "source": {
          "path": "v38",
          "bootstrap": "scripts/bootstrap-v37.sh"
        },
        "host": {
          "packages": [
            "git",
            "nginx",
            "python3-flask",
            "gunicorn"
          ],
          "updatePackages": true,
          "upgradePackages": true,
          "rebootIfRequired": true
        },
        "environment": {
          "NOVATRIX_STORAGE_ACCOUNT": "@output:storage.accountName",
          "NOVATRIX_BLOB_ENDPOINT": "@output:storage.blobEndpoint",
          "NOVATRIX_CONTAINER": "arenden"
        },
        "verify": {
          "host": [
            {
              "name": "cloud-init",
              "run": "cloud-init status --wait",
              "expect": "status: done"
            },
            {
              "name": "bootstrap",
              "run": "test -f /etc/mov/deploy.env && echo present",
              "expect": "present"
            },
            {
              "name": "nginx",
              "run": "systemctl is-active nginx",
              "expect": "active",
              "via": "run-command"
            },
            {
              "name": "form service",
              "run": "systemctl is-active novatrix-form",
              "expect": "active"
            },
            {
              "name": "form reaches storage",
              "run": "curl -sf http://127.0.0.1:8080/health | grep -o '\"status\":\"ok\"'",
              "expect": "\"status\":\"ok\""
            },
            {
              "name": "an errand lands",
              "run": "curl -sf -F name=verify -F email=verify@novatrix.se -F message=verifiering 'http://127.0.0.1/arenden?format=json' | grep -o '\"status\":\"stored\"'",
              "expect": "\"status\":\"stored\""
            },
            {
              "name": "pending upgrades",
              "run": "apt-get -s upgrade | grep -c '^Inst' || true",
              "expect": "0",
              "optional": true
            }
          ]
        }
      }
    ]
  }
}
